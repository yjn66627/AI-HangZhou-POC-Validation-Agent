# 复制为 .env 后在本机填写。不要提交真实 .env。
# 后端启动时会读取仓库根目录 .env。真实密钥只写进 .env，不要写进本模板。
# 规则见 docs/ENV.md

# --- 最小后端（本地演示假值，不是生产密钥，也不是大模型 Key） ---
API_KEY=local-demo-key
EXECUTOR_MODE=FIXTURE
MVP_WORKER_THREADS=4

# --- 收案 Agent：DeepSeek Flash（OpenAI 兼容）。Key 只写进 .env，不要提交 ---
AGENT_LLM_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=<在此填写你自己的 DeepSeek API Key>
AGENT_LLM_MODEL=deepseek-flash

# --- LIVE Executor（未配齐时 LIVE 失败，禁止回退成 Fixture） ---
LIVE_EXECUTOR_KIND=<YUANQI 或 EXTERNAL_PASSTHROUGH>
LIVE_EXECUTOR_URL=<在此填写你自己的地址>
LIVE_EXECUTOR_API_KEY=<在此填写你自己的值>
LIVE_EXECUTOR_TIMEOUT_SECONDS=<在此填写你自己的值>
YUANQI_EXECUTOR_URL=<在此填写你自己的地址>
YUANQI_EXECUTOR_API_KEY=<在此填写你自己的值>
YUANQI_RESPONSE_MAPPING_FILE=<在此填写你自己的映射文件路径>
YUANQI_EXECUTOR_TIMEOUT_SECONDS=<在此填写你自己的值>

# --- 可选自定义 Case registry；未配置时不挂载额外数据集 ---
CASE_REGISTRY_PATH=<在此填写你自己的 Case registry 文件路径>
