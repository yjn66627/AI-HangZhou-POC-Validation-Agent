{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-hangzhou.local/contracts/candidate_plan.schema.json",
  "title": "平台无关候选方案 v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "task_id",
    "case_id",
    "name",
    "approach_type",
    "summary",
    "tools",
    "assumptions",
    "expected_strengths",
    "expected_risks",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "approach_type": {
      "type": "string",
      "enum": [
        "FIXED_TOOL_WORKFLOW",
        "RAG_WORKFLOW",
        "LLM_ONLY",
        "RULE_BASED",
        "LIMITED_AGENT",
        "OTHER"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "model_provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "quality_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_currency": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_dataset": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
