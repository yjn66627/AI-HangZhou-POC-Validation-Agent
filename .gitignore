# ============================================================
# AI POC验证与技术决策智能体 - 公开仓库 .gitignore
# 原则：任何凭据、内部证据、本机隐私信息，一律不得进入版本库。
# ============================================================

# ---------- 环境变量与凭据文件 ----------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.secret
*.secrets
secrets/
credentials/
credential/
*.credential
*token.json
*_token.txt
service-account*.json

# ---------- 评测内部证据（绝不公开） ----------
private_gold/
private-gold/
golden/
golden_evidence/
*private_gold*
*golden_internal*

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---------- Node ----------
node_modules/
.npm/
.pnpm-store/
yarn-error.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

